{
  "info": {
    "name": "Campus Marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth / User",
      "item": [
        {
          "name": "CSRF 토큰 발급",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "csrf"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.csrfToken;",
                  "if (v !== undefined) pm.collectionVariables.set('csrfToken', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nickname}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.accessToken;",
                  "if (v !== undefined) pm.collectionVariables.set('accessToken', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "토큰 갱신",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.accessToken;",
                  "if (v !== undefined) pm.collectionVariables.set('accessToken', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "내 정보",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Category / TradePlace",
      "item": [
        {
          "name": "카테고리 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.items[0] && j.data.items[0].id;",
                  "if (v !== undefined) pm.collectionVariables.set('categoryId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "거래 장소 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trade-places",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade-places"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.items[0] && j.data.items[0].id;",
                  "if (v !== undefined) pm.collectionVariables.set('tradePlaceId', v);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Image",
      "item": [
        {
          "name": "이미지 업로드",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.id;",
                  "if (v !== undefined) pm.collectionVariables.set('imageId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "이미지 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images/{{imageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images",
                "{{imageId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Post",
      "item": [
        {
          "name": "판매글 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"자바의 정석 팝니다\",\n  \"description\": \"상태 좋아요\",\n  \"price\": 15000,\n  \"categoryId\": \"{{categoryId}}\",\n  \"tradePlaceId\": \"{{tradePlaceId}}\",\n  \"imageIds\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.id;",
                  "if (v !== undefined) pm.collectionVariables.set('postId', v);",
                  "pm.collectionVariables.set('postVersion', j.data && j.data.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "판매글 목록·검색",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?q=&categoryId=&status=&sort=&cursor=&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "categoryId",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "sort",
                  "value": ""
                },
                {
                  "key": "cursor",
                  "value": ""
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "판매글 상세",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "판매글 수정",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"{{postVersion}}\",\n  \"title\": \"수정된 제목\",\n  \"price\": 12000\n}"
            }
          }
        },
        {
          "name": "판매글 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}?version={{postVersion}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ],
              "query": [
                {
                  "key": "version",
                  "value": "{{postVersion}}"
                }
              ]
            }
          }
        },
        {
          "name": "거래 상태 변경",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESERVED\",\n  \"version\": \"{{postVersion}}\"\n}"
            }
          }
        },
        {
          "name": "조회 이벤트",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/views",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "views"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Comment",
      "item": [
        {
          "name": "댓글 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/comments?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "comments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "댓글 작성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"아직 판매 중인가요?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.id;",
                  "if (v !== undefined) pm.collectionVariables.set('commentId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "댓글 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Favorite",
      "item": [
        {
          "name": "찜하기",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/favorite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "favorite"
              ]
            }
          }
        },
        {
          "name": "찜 취소",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}/favorite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}",
                "favorite"
              ]
            }
          }
        },
        {
          "name": "찜 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/favorites?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "favorites"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "채팅방 개설·재사용",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": \"{{postId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.data && j.data.id;",
                  "if (v !== undefined) pm.collectionVariables.set('roomId', v);"
                ]
              }
            }
          ]
        },
        {
          "name": "내 채팅방 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "rooms"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "메시지 조회(과거)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "rooms",
                "{{roomId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "메시지 조회(신규)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{roomId}}/messages?afterSequence=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "rooms",
                "{{roomId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "afterSequence",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "메시지 전송",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/rooms/{{roomId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "rooms",
                "{{roomId}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientMessageId\": \"{{$guid}}\",\n  \"content\": \"안녕하세요\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "tradePlaceId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "postVersion",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    }
  ]
}